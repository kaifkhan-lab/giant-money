# All keys are OPTIONAL — the platform runs on key-free live sources
# (Yahoo Finance, SEC EDGAR, Senate/House disclosures, RSS, OpenFIGI).

# Anthropic API key for Claude-powered news summaries.
# Without it, a clearly-labeled local text-analysis fallback is used.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# Financial Modeling Prep — adds fresher politician-trade disclosures.
# FMP_API_KEY=

# Contact declared to SEC EDGAR (their fair-access policy asks for one).
# REQUIRED for a public deployment: EDGAR throttles or blocks requests that
# do not declare a real contact address.
# SEC_USER_AGENT=GIANT-MONEY research you@example.com

# PORT=4600

# Where the SQLite database and cookie jar are written. Set this to a mounted
# volume when hosting (Fly sets it to /data via fly.toml) so data survives
# restarts and redeploys. Defaults to ./data locally.
# DATA_DIR=/data
